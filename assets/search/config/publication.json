{
  "schemaVersion": 1,
  "registry": "config/collections.json",
  "catalog": "catalog.json",
  "runtime": [
    "app.mjs",
    "engine.mjs",
    "collection.mjs",
    "ui-utils.mjs",
    "concordance.mjs",
    "styles.css",
    "vendor/lunr.min.js",
    "vendor/lunr.cjs",
    "vendor/LUNR-LICENSE.txt",
    "vendor/provenance.json"
  ],
  "siteInputs": [
    "_pages/search.html",
    "_includes/search-interface.html"
  ],
  "hookInputs": [
    "bin/cibuild",
    "bin/prepare-reader-publication.mjs"
  ],
  "collections": {
    "bellum-latin-cardwell": {
      "extractor": "extract.py",
      "outputDirectory": ".",
      "sources": [
        "assets/xml/bellum/Latin/book-01.xml",
        "assets/xml/bellum/Latin/book-02.xml",
        "assets/xml/bellum/Latin/book-03.xml",
        "assets/xml/bellum/Latin/book-04.xml",
        "assets/xml/bellum/Latin/book-05.xml",
        "assets/xml/bellum/Latin/book-06.xml",
        "assets/xml/bellum/Latin/book-07.xml"
      ],
      "verifier": "tests/corpus-qa.mjs",
      "qaReport": "qa-report.json"
    },
    "contra-apionem-latin-boysen": {
      "extractor": "extract-ca.py",
      "outputDirectory": "data/contra-apionem-latin-boysen",
      "sources": [
        "assets/xml/contra-apionem/Latin/book-01.xml",
        "assets/xml/contra-apionem/Latin/book-02.xml"
      ],
      "verifier": "tests/ca-corpus-qa.mjs",
      "qaReport": "data/contra-apionem-latin-boysen/qa-report.json"
    },
    "deh-latin-ussani": {
      "extractor": "extract-deh.py",
      "outputDirectory": "data/deh-latin-ussani",
      "sources": [
        "assets/xml/deh/Latin/book-01.xml",
        "assets/xml/deh/Latin/book-02.xml",
        "assets/xml/deh/Latin/book-03.xml",
        "assets/xml/deh/Latin/book-04.xml",
        "assets/xml/deh/Latin/book-05.xml"
      ],
      "verifier": "tests/deh-corpus-qa.mjs",
      "qaReport": "data/deh-latin-ussani/qa-report.json"
    },
    "antiquities-latin-bamberg78": {
      "extractor": "extract-antiquities.py",
      "outputDirectory": "data/antiquities-latin-bamberg78",
      "sources": [
        "assets/xml/antiquities/Latin/preface.xml",
        "assets/xml/antiquities/Latin/book-01.xml",
        "assets/xml/antiquities/Latin/book-02.xml",
        "assets/xml/antiquities/Latin/book-03.xml",
        "assets/xml/antiquities/Latin/book-04.xml",
        "assets/xml/antiquities/Latin/book-05.xml",
        "assets/xml/antiquities/Latin/book-06.xml",
        "assets/xml/antiquities/Latin/book-07.xml",
        "assets/xml/antiquities/Latin/book-08.xml",
        "assets/xml/antiquities/Latin/book-09.xml",
        "assets/xml/antiquities/Latin/book-10.xml"
      ],
      "verifier": "tests/antiquities-corpus-qa.mjs",
      "qaReport": "data/antiquities-latin-bamberg78/qa-report.json"
    }
  }
}
