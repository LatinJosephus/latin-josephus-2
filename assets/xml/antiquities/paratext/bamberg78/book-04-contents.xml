      <div type="contents" subtype="marginal-capitula" source="#bamberg78 #word-transcription" xml:id="bamberg78-ant-04-contents">
        <head>Haec sunt In qvarto libro ioseppi antiquitatis.</head>
        <head>Incipiunt Capitula Libri</head>
        <list type="capitula">
          <item n="I">I Bellum hebraeor<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p26-i1">um</supplied> <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p26-i2">absque</supplied> notitia \m/oseos cont<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p26-i3">ra cha</supplied>naneos gestum atque <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p26-i4">deuictio</supplied>.</item>
          <item n="II">II Seditio eorum et <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p27-i1">plebis</supplied> contra mosen e<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p27-i2">t fratrem</supplied> eius de sacerdo<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p27-i3">tio</supplied>.</item>
          <item n="III">III Ea quae prouene<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p28-i1">runt</supplied> hebraeis in he<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p28-i2">remo </supplied>annis octo et t<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p28-i3">riginta</supplied>.</item>
          <item n="IIII">IIII Quemadmodum <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p29-i1">cum sichem et og</supplied> haec amorraeor<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p29-i2">um</supplied> <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p29-i3">reges</supplied> uicisset moses et <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p29-i4">eorum</supplied> exercitus perem<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p29-i5">isset</supplied>, diuisit regionem <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p29-i6">eorum</supplied> duabus et medie <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p29-i7">tribubus</supplied> hebraeorum.</item>
          <item n="V">V Vita moseos &amp; <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p30-i1">quem</supplied>admodum ex ho<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-04-p30-i2">minibus</supplied> [...]si est ablatus.</item>
        </list>
        <trailer>EXPLICIT CAPITULA.</trailer>
