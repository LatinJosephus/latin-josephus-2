      <div type="contents" subtype="marginal-capitula" source="#bamberg78 #word-transcription" xml:id="bamberg78-ant-03-contents">
        <head>Incipiunt capitula libri III</head>
        <list type="capitula">
          <item n="I">I Quomodo moyses popu<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p10-i1">lum</supplied> ex aegypto sumens de<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p10-i2">duxit</supplied> ad montem sina multum itinere fatigatum.</item>
          <item n="II">II Quomodo pugnantes cum hebraeis amalechi<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p11-i1">tae</supplied> &amp; qui circa eos erant <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p11-i2">de</supplied>uicti sunt &amp; israhelitae <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p11-i3">prae</supplied>dam hostium perceperunt.</item>
          <item n="III">III Quia socerum suum ieth<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p12-i1">or</supplied> in moyses ad se  uenien<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p12-i2">tem</supplied> ad montem sina liben<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p12-i3">ter</supplied> excepit.</item>
          <item n="IIII">IIII Quomodo persuasit ei <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p13-i1">ut</supplied> distribueret populum <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p13-i2">per</supplied> millenarios et centen<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p13-i3">arios</supplied> qui prius inordinatus e<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p13-i4">rat.</supplied></item>
          <item n="V">V Quomodo haec singu<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p14-i1">la</supplied> fecit moyses socero com<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p14-i2">monente.</supplied></item>
          <item n="VI">VI Quomodo ascendens <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p15-i1">moy</supplied>ses in sina monte acce<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p15-i2">ptas</supplied> a deo leges hebraeis d<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p15-i3">edit</supplied>.</item>
          <item n="VII">VII De tabernaculo quod f<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p16-i1">ecit</supplied> in deserto moyses ad <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p16-i2">ho</supplied>norem dei ut templum esse uideretur.</item>
          <item n="VIII">VIII Quae sint  uestimenta s<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p17-i1">acer</supplied>dotum &amp; pontificis et quia <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p17-i2">pu</supplied>rificationes et quemadm<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p17-i3">odum</supplied> de festiuitatibus et singu<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p17-i4">lis</supplied> diebus fieri a constitutu<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p17-i5">m</supplied>.</item>
          <item n="VIIII">VIIII Quo modo exind<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p18-i1">e</supplied> moyses eduxit populum a<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p18-i2">d fi</supplied>nes chananeorum &amp; exp<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p18-i3">lo</supplied>ratores qui considerar<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p18-i4">ent</supplied> eorum regiones et ciui<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p18-i5">tatum</supplied> magnitudines destina<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p18-i6">uit.</supplied></item>
          <item n="X">X Quia his qui missi fuerant <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i1">post</supplied> xl dies reuersiss et dicet<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i2">ibus,</supplied> quia ipsi inbellos essent et ch<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i3">ana</supplied>neorum extollentibus  uirtut<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i4">em</supplied>, multitudo turbata sit et a<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i5">d des</supplied>perationem  ueniens imp<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i6">etum</supplied> fecit ut paulatim moysen <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i7">dese</supplied>reret &amp; iterum in aegypt<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i8">um</supplied>  ueniret &amp; seruitium sustin<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p19-i9">eret</supplied>.</item>
          <item n="XI">XI Quomodo in hoc moyses fure<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p20-i1">ns</supplied> deum eis iratum et xl annis eo<supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p20-i2">s</supplied> in deserto moraturos esse praedixit <supplied reason="lost" source="#blatt" resp="#human-editor" rend="italic" xml:id="bamberg78-ant-03-p20-i3">et neque in aegyptum reuersuros neque chananaeam esse potituros.</supplied> </item>
        </list>
        <note type="editorial" resp="#human-editor">Italicized text has been supplied from Blatt’s edition where trimming of the manuscript margins has removed words.</note>
      </div>
